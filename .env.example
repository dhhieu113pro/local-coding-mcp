# Copy to .env in this same folder, then: docker compose up -d
#   copy .env.example .env
#
# Do NOT commit .env

# OpenAI — https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI runtime key — https://platform.openai.com/settings/organization/api-keys
# Needs Tunnels Read + Use
CONTROL_PLANE_API_KEY=sk-proj-xxxxxxxx

# Host folder with your code (forward slashes on Windows)
# Windows:
MCP_WORKSPACE=D:/wslc/workspaces
# WSL:
# MCP_WORKSPACE=/home/you/projects

# Optional IDE password (docker compose --profile ide up -d)
CODE_SERVER_PASSWORD=changeme
