# Copy to .env in this same folder:
#   copy .env.example .env
# Do NOT commit .env

# === Host code folder (forward slashes on Windows) ===
MCP_WORKSPACE=D:/wslc/workspaces
# MCP_WORKSPACE=/home/you/projects

# === OpenAI Secure MCP Tunnel (default compose stack) ===
# https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# https://platform.openai.com/settings/organization/api-keys  (Tunnels Read + Use)
CONTROL_PLANE_API_KEY=sk-proj-xxxxxxxx

# === ngrok (optional public HTTPS) ===
# https://dashboard.ngrok.com/get-started/your-authtoken
# Start: docker compose up -d local-coding-mcp
#        docker compose --profile ngrok up -d
NGROK_AUTHTOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# === Optional IDE ===
# docker compose --profile ide up -d
CODE_SERVER_PASSWORD=changeme
