# Copy to .env and fill in real values. Never commit .env
#
#   cp .env.example .env

# === Required for ChatGPT Secure MCP Tunnel ===
# Create tunnel: https://platform.openai.com/settings/organization/tunnels
CONTROL_PLANE_TUNNEL_ID=tunnel_0123456789abcdef0123456789abcdef

# Runtime API key (Tunnels Read + Use):
# https://platform.openai.com/settings/organization/api-keys
CONTROL_PLANE_API_KEY=sk-proj-xxxxxxxx

# === Workspace folder on your machine ===
# Windows PowerShell / Docker Desktop example:
# MCP_WORKSPACE=D:/wslc/workspaces
# WSL example:
# MCP_WORKSPACE=/home/you/projects
MCP_WORKSPACE=./workspace

# === Optional: browser IDE (code-server) ===
CODE_SERVER_PASSWORD=changeme

# === Optional: GitHub token (private git clone only) ===
# Create PAT: https://github.com/settings/tokens
# GITHUB_TOKEN=ghp_xxxxxxxx
