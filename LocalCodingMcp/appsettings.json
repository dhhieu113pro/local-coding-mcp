{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedRoots": [
    "/tmp/mcp-workspace"
  ],
  "CommandTimeoutSeconds": 30,
  "MaxSearchResults": 50,
  "ExecutionHistory": {
    "FilePath": "data/execution-history.jsonl",
    "MaxArgumentLength": 2000,
    "MaxFileSizeMb": 10
  },
  "BlockedFileNames": [
    ".env",
    ".env.local",
    ".env.production",
    "id_rsa",
    "id_rsa.pub",
    "id_ed25519",
    "id_ed25519.pub",
    "*.pem",
    "*.pfx",
    "*.p12",
    "*.key",
    "credentials.json",
    "secrets.json",
    "appsettings.Production.json"
  ]
}
